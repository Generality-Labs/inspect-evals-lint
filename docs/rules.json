      "url": "https://inspect-evals-lint.generality.org/rules/IETS002/",
      "markdown": "https://inspect-evals-lint.generality.org/rules/IETS002.md"
    },
    {
      "code": "IETS003",
      "name": "e2e_test",
      "category": "tests",
      "scopes": [
        "eval"
      ],
      "allowlist": false,
