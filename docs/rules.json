      "markdown": "https://inspect-evals-lint.generality.org/rules/IEBP002.md"
    },
    {
      "code": "IEBP003",
      "name": "sample_ids",
      "category": "best_practices",
      "scopes": [
        "eval",
        "helper"
      ],
      "allowlist": false,
      "summary": "Every Sample() passes id=",
